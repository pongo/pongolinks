[Unit]
Description=pongolinks
After=network.target

[Service]
Type=simple
User=pongolinks
Group=pongolinks
WorkingDirectory=/opt/pongolinks/current
EnvironmentFile=/etc/pongolinks/pongolinks.env
ExecStart=/usr/local/bin/bun apps/backend/dist/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
