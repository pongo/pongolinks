{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": true,
    "isolatedModules": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "verbatimModuleSyntax": true
  }
}
