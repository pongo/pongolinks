{
  "manifest_version": 3,
  "name": "pongolinks",
  "version": "0.2.1",
  "description": "Detects saved bookmarks and opens pongolinks bookmark creation for the current tab.",
  "homepage_url": "http://localhost:5173/pl/",
  "action": {
    "default_title": "Save to pongolinks",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png"
    },
    "theme_icons": [
      {
        "dark": "images/icon-16.png",
        "light": "images/icon-dark-16.png",
        "size": 16
      },
      {
        "dark": "images/icon-32.png",
        "light": "images/icon-dark-32.png",
        "size": 32
      }
    ]
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/pl/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png"
  },
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "pongolinks@pavel.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
