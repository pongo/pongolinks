{
  "name": "@pongolinks/frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "agent:test": "vitest run --passWithNoTests --no-color --reporter=agent",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@elysiajs/eden": "^1.3.0",
    "@pongolinks/backend": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.6",
    "elysia": "^1.4.28",
    "vite": "^8.0.11",
    "vue": "^3.5.13",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "vue-tsc": "^3.2.8"
  }
}
