{
  "name": "@pongolinks/backend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/app.ts"
  },
  "scripts": {
    "dev": "cd ../.. && bun --watch apps/backend/src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun --sourcemap",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "agent:test": "vitest run --no-color --reporter=agent",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@eelkevdbos/elysia-basic-auth": "^2.0.1",
    "@elysia/openapi": "^1.4.15",
    "@elysia/opentelemetry": "^1.4.12",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@pongolinks/db": "workspace:*",
    "@pongolinks/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "evlog": "^2.17.0",
    "quick-lru": "^7.3.0",
    "zod": "^4.4.3"
  }
}
