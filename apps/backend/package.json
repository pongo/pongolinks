{
  "name": "@pongolinks/backend",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "agent:test": "vitest run --no-color --reporter=agent",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@elysiajs/static": "^1.3.0",
    "elysia": "^1.3.2"
  },
  "devDependencies": {
    "@pongolinks/frontend": "workspace:*"
  }
}
