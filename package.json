{
  "name": "pongolinks",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "oxfmt package.json turbo.json tsconfig.base.json scripts apps packages",
    "db:migrate": "bun scripts/ensure-data-dir.ts && bun run --filter @pongolinks/db db:migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.2.13",
    "drizzle-kit": "^0.31.1",
    "oxfmt": "^0.45.0",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "packageManager": "bun@1.3.13"
}
