{
  "name": "pongolinks",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@pongolinks/frontend --filter=@pongolinks/backend",
    "dev:tui": "turbo run dev --filter=@pongolinks/frontend --filter=@pongolinks/backend --ui=tui",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "agent:test": "turbo run agent:test",
    "format": "oxfmt package.json turbo.json tsconfig.base.json scripts apps packages",
    "db:migrate": "bun scripts/ensure-data-dir.ts && bun run --filter @pongolinks/db db:migrate"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.48.0",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "bun@1.3.13"
}
