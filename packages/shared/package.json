{
  "name": "@pongolinks/shared",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "agent:test": "vitest run --passWithNoTests --no-color --reporter=agent",
    "format": "oxfmt ."
  }
}
