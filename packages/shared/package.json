{
  "name": "@pongolinks/shared",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app-config": "./src/app-config.ts",
    "./bookmark-description": "./src/bookmark-description/index.ts",
    "./errors": "./src/errors/index.ts",
    "./result": "./src/result/result.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "agent:test": "vitest run --passWithNoTests --no-color --reporter=agent",
    "format": "oxfmt ."
  },
  "dependencies": {
    "autolinker": "^4.1.5"
  }
}
